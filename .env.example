# Optional: Web3Forms access key so Contact + Sourcing submissions POST from the browser
# (works on Netlify, GoDaddy static hosting, etc.). Register at https://web3forms.com with
# sales@forezcorp.com as the inbox, then paste the key here and in your host env (rebuild required).
# If unset, submissions use mailto:sales@forezcorp.com only.
# VITE_WEB3FORMS_ACCESS_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
